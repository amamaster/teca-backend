# Copia este archivo como .env y ajusta los valores

# MongoDB en Docker (ajusta el puerto si tu contenedor usa otro)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=teca

# Seguridad
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRE_MINUTES=1440

# Reglas de negocio
SHIPPING_COST=25.00
FREE_SHIPPING_THRESHOLD=300.00

# Orígenes del frontend (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# En dev los tokens de verificación/reseteo se devuelven en la respuesta
DEV_MODE=true
